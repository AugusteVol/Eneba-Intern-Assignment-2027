<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="Cart SPA route" stopProcessing="true">
          <match url="^cart/?$" />
          <action type="Rewrite" url="/index.html" />
        </rule>
        <rule name="Favorite SPA route" stopProcessing="true">
          <match url="^favorites/?$" />
          <action type="Rewrite" url="/index.html" />
        </rule>
        <rule name="CheapGames SPA route" stopProcessing="true">
          <match url="^cheap-games/?$" />
          <action type="Rewrite" url="/index.html" />
        </rule>
        <rule name="Register SPA route" stopProcessing="true">
          <match url="^register/?$" />
          <action type="Rewrite" url="/index.html" />
        </rule>
        <rule name="Login SPA route" stopProcessing="true">
          <match url="^login/?$" />
          <action type="Rewrite" url="/index.html" />
        </rule>
        <rule name="Payment SPA route" stopProcessing="true">
          <match url="^payment/?$" />
          <action type="Rewrite" url="/index.html" />
        </rule>
        <rule name="Key SPA route" stopProcessing="true">
          <match url="^key/?$" />
          <action type="Rewrite" url="/index.html" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
